# Copiar como .env (en local y en el servidor) y ajustar los valores.

# Local: True. Producción: False (o no ponerla).
DEBUG=True

# Producción: clave propia, generarla con
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Dominios separados por coma. Producción: el dominio real (ej. dominio.edu.do).
ALLOWED_HOSTS=localhost,127.0.0.1

# Prefijo de la app en producción (ej. /app1). Vacío en local.
APP_PATH=

# Puerto del servidor donde escucha nginx (debe coincidir con el ProxyPass de Apache).
# Uno distinto por proyecto. Solo lo usa docker compose.
APP_PORT=8015

# Producción: Postgres del servidor (fuera de Docker). Vacío en local → SQLite.
#   DATABASE_URL=postgres://USUARIO:PASSWORD@host.docker.internal:5432/NOMBRE_DB
# SQLite en producción (en el volumen db_volume; cuatro barras = ruta absoluta):
#   DATABASE_URL=sqlite:////app/data/db.sqlite3
DATABASE_URL=
